#include <winresrc.h>

#include "resource.h"

IDR_DEFAULT_SETTINGS RCDATA "default_settings.json"
IDR_IMGUI_LICENSE RCDATA "../vendor/imgui/LICENSE.txt"
IDR_DETOURS_LICENSE RCDATA "../vendor/detours/LICENSE.md"
IDR_LOGO_SHEET RCDATA "dawn_logo.png"

VS_VERSION_INFO VERSIONINFO
FILEVERSION DAWN_VER_MAJOR, DAWN_VER_MINOR, DAWN_VER_PATCH, DAWN_VER_BUILD
PRODUCTVERSION DAWN_VER_MAJOR, DAWN_VER_MINOR, DAWN_VER_PATCH, DAWN_VER_BUILD
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0409 is US English and 04B0 is UTF-16, which is the pair the VarFileInfo block declares.
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Dawn 1.7.1"
            VALUE "FileVersion", DAWN_VER_STRING
            VALUE "InternalName", "Dawn"
            // The shipped file carries the name the game delay-imports, not the module's own.
            VALUE "OriginalFilename", "steam_api64.dll"
            VALUE "ProductName", "Dawn"
            VALUE "ProductVersion", DAWN_VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
